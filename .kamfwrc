# shellcheck shell=ash
export MODDIR=${MODPATH:-${MODDIR:-${1:-${0%/*}}}}
. "$MODDIR/.config/kamfw/.envrc" || return 1
for _kamfw_rcfile in "$MODDIR/.config/kamfw/env.d/"*.envrc; do
    [ ! -r "$_kamfw_rcfile" ] || . "$_kamfw_rcfile" || return 1
done
unset _kamfw_rcfile

[ -t 1 ] && export IS_TTY=true || export IS_TTY=false
NL='
'

tprint() { if $IS_TTY; then printf '%s\n' "$*"; fi; }
gprint() { if ! $IS_TTY; then printf '%s\n' "$*"; fi; }
print() {
    if [ "${BOOTMODE:-true}" = true ]; then
        printf '%s\n' "${1:-}"
    elif [ -e "/proc/self/fd/${OUTFD:-}" ]; then
        printf 'ui_print %s\nui_print\n' "${1:-}" >&"$OUTFD"
    fi
}
ui_print() { print "$@"; }
has_command() { command -v "$1" >/dev/null 2>&1; }

_kamfw_load() {
    case " ${KAM_MODULES:-} " in *" $1 "*) return 0 ;; esac
    [ -f "$KAMFW_DIR/$1.sh" ] || { print "Error: Module '$1' not found"; return 1; }
    # Positional arguments survive nested imports without shared scratch state.
    . "$KAMFW_DIR/$1.sh" || return $?
    KAM_MODULES="${KAM_MODULES:-} $1"
}

_kamfw_list() {
    print 'Available modules:'
    for _kamfw_module in ${KAM_MODULES:-}; do print "  $_kamfw_module"; done
    unset _kamfw_module
}

_kamfw_help() {
    print 'Usage: kamfw <command>'
    print 'Commands:'
    print '  load <module>'
    print '  unload <module>'
    print '  list'
    print '  help'
}

kamfw() {
    case "${1:-}" in
        load) shift; _kamfw_load "$@" ;;
        list) _kamfw_list ;;
        *) _kamfw_help ;;
    esac
}
import() { _kamfw_load "$@"; }

if ! has_command abort; then
    abort() { print "ERROR: $1"; exit 1; }
fi

if ! has_command set_perm; then
    set_perm() (
        [ $# -ge 4 ] || abort 'set_perm needs at least 4 arguments'
        [ -e "$1" ] || abort "set_perm: Target '$1' not found"
        chown "$2:$3" "$1" && chmod "$4" "$1" || return 1
        if has_command chcon; then chcon "${5:-u:object_r:system_file:s0}" "$1" 2>/dev/null || true
        elif has_command restorecon; then restorecon "$1"; fi
    )
fi
if ! has_command set_perm_recursive; then
    set_perm_recursive() (
        [ $# -ge 5 ] || abort 'set_perm_recursive needs at least 5 arguments'
        [ -d "$1" ] || abort "set_perm_recursive: Dir '$1' not found"
        chown -R "$2:$3" "$1" && find "$1" -type d -exec chmod "$4" {} + &&
            find "$1" -type f -exec chmod "$5" {} + || return 1
        if has_command chcon; then chcon -R "${6:-u:object_r:system_file:s0}" "$1" 2>/dev/null || true
        elif has_command restorecon; then restorecon -R "$1"; fi
    )
fi

import i18n && import base && import logging && import kam
